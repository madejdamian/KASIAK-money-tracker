# Copy to `.env` on the server (it is ignored by git) and fill in. Never commit the real file.

# The address of the app in your Tailscale network, with https://, e.g. https://sandra215.tail1234.ts.net
# (the app uses it for CORS; `tailscale serve` prints it).
FRONTEND_PORT=https://sandra215.tail1234.ts.net

DB_NAME=kasiak
DB_USER=kasiak
# a long random value (the database is not reachable from outside, you never type it)
DB_PASSWORD=change-me

# Base64 key for the login tokens: openssl rand -base64 32
JWT_SECRET_KEY=change-me
# Lifetimes in milliseconds (1 hour and half a year)
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=15552000000

# The password you type to log in (at least 8 characters). It is set again on every start.
APP_PASSWORD=change-me
