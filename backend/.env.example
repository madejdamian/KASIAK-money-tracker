# Copy to backend/.env-dev (used by compose.yml) and adjust the values.
DB_DRIVER=org.postgresql.Driver
DB_HOST=db
DB_PORT=5432
DB_NAME=et_db
DB_USER=postgres
DB_PASSWORD=postgres
DDL_AUTO=none
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SHOW_SQL=false

# Base64-encoded HS256 key, e.g. generate with: openssl rand -base64 32
JWT_SECRET_KEY=change-me
# Lifetimes in milliseconds
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=15552000000

# Origin of the frontend allowed by CORS
FRONTEND_PORT=http://localhost:5173

# Credentials of the single household account (applied on every startup)
APP_USERNAME=household
APP_PASSWORD=change-me
