# Copy to `.env` on the server (it is ignored by git) and fill in. Never commit the real file.

# Public address of the app. Without a domain use the server IP with dashes and sslip.io,
# e.g. IP 203.0.113.7 -> 203-0-113-7.sslip.io (Caddy gets a certificate for it automatically).
KASIAK_HOST=203-0-113-7.sslip.io
# Must be the same address with https:// (the app uses it for CORS)
FRONTEND_PORT=https://203-0-113-7.sslip.io

DB_NAME=kasiak
DB_USER=kasiak
# a long random value (the database is not reachable from outside, you never type it)
DB_PASSWORD=change-me

# Base64 key for the login tokens: openssl rand -base64 32
JWT_SECRET_KEY=change-me
# Lifetimes in milliseconds (1 hour and half a year)
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=15552000000

# The password you type to log in. It is set again on every start.
APP_PASSWORD=change-me
